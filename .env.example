# 从 OpenRouter 控制台创建 API Key，再复制本文件为 .env 并替换下面的内容。
OPENROUTER_API_KEY=your_openrouter_api_key

# PostgreSQL用于持久化保存Agent的聊天消息和最近一次类案结果。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=langgraph
DATABASE_URL=postgresql://postgres:change_this_password@127.0.0.1:5432/langgraph?sslmode=disable
